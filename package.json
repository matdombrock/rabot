{
  "name": "rb-zero",
  "version": "1.0.0",
  "description": "Discord bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "backfill": "tsx src/backfill.ts",
    "build": "tsc && npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "typecheck": "tsc --noEmit",
    "user": "tsx src/cli-users.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.26.5",
    "express": "^5.2.1",
    "lowdb": "^7.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/sharp": "^0.35.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
